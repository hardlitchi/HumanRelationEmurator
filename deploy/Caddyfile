# compose の proxy サービス用。TLS は外部のリバースプロキシで終端する前提で、ここは http のまま
# /mcp を MCP サーバーへ、それ以外を Web UI へ振り分けて、公開ポートを1つにまとめる
{
	auto_https off
	admin off
	servers {
		# 外部のリバースプロキシが付けた X-Forwarded-Proto / -For をそのまま渡す
		trusted_proxies static private_ranges
	}
}

:8080 {
	handle /mcp* {
		reverse_proxy mcp:8000
	}
	# AITuber ごとのトークンで設定と人間関係を読む API（KAGURA STAGE などが使う）。MCP サーバーが持つ
	handle /api/* {
		reverse_proxy mcp:8000
	}
	# OAuth（claude.ai のカスタムコネクタなど）。認可サーバーも MCP サーバーが兼ねる
	@oauth path /.well-known/oauth-* /authorize /token /register /revoke
	handle @oauth {
		reverse_proxy mcp:8000
	}
	handle {
		reverse_proxy web:8001
	}
}
