# HumanRelationEmurator の docker compose 用設定
#   cp .env.example .env して値を埋める。.env は git に入れない（.gitignore 済み）
#   詳しい手順は docs/docker.md

# ---- 必須 -----------------------------------------------------------------

# PostgreSQL の hre ユーザーのパスワード。DATABASE_URL に埋め込むので英数字だけにする
#   生成: openssl rand -hex 24
#   注意: DB は初回起動時にこの値で作られる。あとから変えても既存の DB には反映されない
#         （変えるなら docker compose exec db psql -U hre -d hre -c "ALTER USER hre PASSWORD '...'" も実行）
POSTGRES_PASSWORD=change-me-openssl-rand-hex-24

# Web UI のログイン Cookie の署名鍵。変えると全員ログインし直しになる
#   生成: openssl rand -hex 32
#   （openssl がなければ: python3 -c "import secrets; print(secrets.token_hex(32))"）
HRE_WEB_SECRET=change-me-openssl-rand-hex-32

# 公開するドメイン（外部のリバースプロキシで受けるもの）。エージェントは https://<ドメイン>/mcp、スマホは https://<ドメイン>/ に接続する
#   MCP サーバーと Web UI の Host ヘッダ許可リスト（DNS リバインディング対策）にも使う
#   手元で試すだけなら localhost
HRE_DOMAIN=hre.example.com

# ---- 任意（既定値のままでよい） ---------------------------------------------

# MCP の認証メタデータに出す外部 URL。既定は https://${HRE_DOMAIN}
#   手元で http のまま試すなら http://localhost:8080（HRE_PORT に合わせる）
# HRE_PUBLIC_URL=https://hre.example.com

# パスキーが結びつくドメイン（RP ID）。既定は HRE_PUBLIC_URL のホスト名。
#   親ドメイン（例: example.com）にしたいときだけ設定する。変えると登録済みのパスキーは使えなくなる
# HRE_PASSKEY_RP_ID=hre.example.com

# ホストに公開するポート。外部のリバースプロキシ（TLS 終端）からここへ転送する
#   この1ポートで /mcp はエージェント用 MCP サーバー、それ以外はスマホ用 Web UI に振り分ける
HRE_PORT=8080

# 公開ポートを待ち受けるアドレス。既定は 127.0.0.1（同じ VPS 上のリバースプロキシからだけ届く）
#   リバースプロキシが別のマシンにあるときだけ、そのマシンから届くアドレス（例: 0.0.0.0）にする
#   ここは TLS なしの http なので、インターネットに直接さらさないこと
# HRE_BIND_ADDRESS=127.0.0.1

# Web UI に表示する時刻のタイムゾーン
# HRE_TIMEZONE=Asia/Tokyo

# 1 にすると Cookie の Secure 属性を外す。http://localhost で試すときだけ使い、VPS では 0 のまま
# HRE_INSECURE_COOKIES=0
